{
  "name": "tar-vern",
  "version": "0.0.1",
  "description": "Tape archiver library for Typescript",
  "keywords": [
    "typescript",
    "tar",
    "async",
    "stream"
  ],
  "author": "Kouji Matsui (@kekyo@mi.kekyo.net)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kekyo/tar-vern.git"
  },
  "homepage": "https://github.com/kekyo/tar-vern#readme",
  "readme": "README_pack.md",
  "engines": {
    "node": ">=22.17.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "files": [
    "dist",
    "images/tar-vern-120-c.png"
  ],
  "scripts": {
    "dependencies": "reskill",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "dump": "npm run build && screw-up dump",
    "pack": "npm run build && screw-up pack --pack-destination artifacts/"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.83",
    "@types/node": ">=20.0.0",
    "dayjs": ">=1.11.0",
    "prettier-max": "^1.16.0",
    "resolved-killer": "^1.1.0",
    "screw-up": ">=0.13.0",
    "typescript": ">=5.0.0",
    "vite": ">=5.0.0",
    "vite-plugin-dts": ">=3.0.0",
    "vitest": ">=1.0.0"
  }
}
